
# Base URL the Frontend issues every API request against. Every Auth route
# now lives under the v1 prefix alongside Agents/Alerts/Observations/
# Dashboard/Organization/Audit, so this one base covers all of them.
# Relative by default (same-origin); point at an absolute URL only if the
# Backend is served from a different origin.
VITE_API_BASE_URL=/api/v1

# Set to "true" to run the Frontend entirely against in-memory mock data
# (src/lib/mockDb.js) instead of a live Backend — useful for offline/demo
# use. Leave unset or "false" for normal development against a real Backend
# (see src/lib/apiClient.js).
VITE_MOCK_MODE=true