# ASES SDK — environment configuration
# See docs/getting-started.md and environment-configuration.md for the full contract.

# Required. Issued when you register your Agent in the SentinelX Dashboard.
ASES_API_KEY=ases_xxxxxxxxx

# Optional. Override only if you're not targeting the SentinelX production API
# (e.g. a local/staging Laravel instance during development).
ASES_ENDPOINT=https://api.sentinelx.example.com

# Optional. Free-form label for your own environment separation.
ASES_ENVIRONMENT=production
