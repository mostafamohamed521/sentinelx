APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# ERROR-007: false by default -- a debug-mode example default risks shipping
# into a real deployment and leaking exception file/line/trace detail via
# Laravel's own default rendering for exception types this phase's
# bootstrap/app.php catch-alls don't intercept (e.g. HttpExceptionInterface
# instances). See ErrorEnvelopePolicyTest's leak-regression test.
APP_DEBUG=false
APP_URL=http://localhost

# SECURITY-001: the trusted browser origin(s) allowed to make cross-origin
# requests against api/*, see config/cors.php. Comma-separated for more
# than one (e.g. staging + production Frontends).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

# FAILURE-001: session and cache are deliberately isolated from the primary
# PostgreSQL connection (see adr/ADR-007-session-cache-database-isolation.md)
# so a business-database outage doesn't also destroy every already-
# authenticated user's session or the cache layer. Requires ext-redis or
# predis/predis (see REDIS_CLIENT below) and a reachable Redis instance.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# QUEUE_CONNECTION intentionally remains on the database connection — this is
# a known, accepted trade-off, not an oversight. See
# adr/ADR-007-session-cache-database-isolation.md §"Why not the queue too".
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGO=HS256

# PERF-002: the Analysis Poller's global (not per-Organization) throughput
# ceiling — see docs/05-analysis/03-processing-pipeline.md §"Capacity".
# Scheduled every minute (routes/console.php), so this is also the
# platform's real, documented "Observations analyzed per minute" ceiling.
ANALYSIS_POLL_BATCH_LIMIT=10

# Backend -> ML Engine (see docs/05-analysis/04-ml-client-contract.md §3).
# ML_SERVICE_TOKEN is required, not optional, as of the integration audit's
# SECURITY-004 fix -- MLClient fails loudly at first use if this is unset,
# and the ML Service itself rejects any request without a matching bearer
# token. Set the same value on both sides.
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=
